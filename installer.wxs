<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="RAMFlux" Manufacturer="RAMFlux" Version="1.1.0"
           UpgradeCode="7E52A1B3-8C4D-4F2E-9A6B-1C3D5E7F9A0B"
           Compressed="yes" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of RAMFlux is already installed." />
    <Media Id="1" Cabinet="ramflux.cab" EmbedCab="yes" />
    <Property Id="ARPPRODUCTICON" Value="RAMFluxIcon" />
    <WixVariable Id="WixUILicenseRtf" Value="installer\eula.rtf" />
    <Property Id="ARPCOMMENTS" Value="Memory optimization and system diagnostics tool" />
    <Property Id="ARPCONTACT" Value="RAMFlux" />
    <Property Id="ARPURLINFOABOUT" Value="https://ramflux.example.com" />
    <Property Id="ARPURLUPDATEINFO" Value="https://ramflux.example.com/updates" />
    <Property Id="ApplicationFolderName" Value="RAMFlux" />
    <Property Id="WixAppFolder" Value="WixPerMachineFolder" />

    <!-- Install UI wizard (Next / Back / Finish) -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="DIR_RAMFlux" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="DIR_RAMFlux" Name="RAMFlux">
        <Directory Id="DIR_iconengines" Name="iconengines" />
        <Directory Id="DIR_imageformats" Name="imageformats" />
        <Directory Id="DIR_networkinformation" Name="networkinformation" />
        <Directory Id="DIR_platforms" Name="platforms" />
        <Directory Id="DIR_styles" Name="styles" />
        <Directory Id="DIR_tls" Name="tls" />
        <Directory Id="DIR_generic" Name="generic" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="DIR_RAMFluxShortcuts" Name="RAMFlux">
        <Component Id="C_Shortcuts" Guid="A7B9D1E3-F5C7-4902-B1A3-C5D7E9F1B3D5">
          <Shortcut Id="S_RAMFlux" Name="RAMFlux" Description="RAMFlux - Memory Optimizer"
                    Target="[DIR_RAMFlux]RAMFlux.exe" WorkingDirectory="DIR_RAMFlux">
            <Icon Id="RAMFluxIcon" SourceFile="C:\Users\NitroV15\Documents\RAMFlux\build\deploy\RAMFlux.exe" />
          </Shortcut>
          <Shortcut Id="S_RAMFluxUninstall" Name="RAMFlux (Uninstall)" Description="Uninstall RAMFlux"
                    Target="[System64Folder]msiexec.exe" Arguments="/x [ProductCode]" />
          <RemoveFolder Id="RF_RAMFluxShortcuts" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\RAMFlux" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="F_RAMFlux" Title="RAMFlux" Level="1" TypicalDefault="install">
      <ComponentGroupRef Id="CG_RAMFlux" />
      <ComponentRef Id="C_Shortcuts" />
    </Feature>
  </Package>
