#include <windows.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,1,0,0
PRODUCTVERSION  1,1,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "RAMFlux Technologies"
            VALUE "FileDescription",  "RAMFlux - Intelligent Memory Orchestrator"
            VALUE "FileVersion",      "1.1.0.0"
            VALUE "InternalName",     "RAMFlux"
            VALUE "LegalCopyright",   "Copyright (C) 2026 RAMFlux Technologies"
            VALUE "OriginalFilename", "RAMFlux.exe"
            VALUE "ProductName",      "RAMFlux"
            VALUE "ProductVersion",   "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDI_ICON1 ICON "app.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"
